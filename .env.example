# Environment Variables Template
# Copy this file to .env.local — NEVER commit .env.local to version control

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Nazeefa

# ─── Database (Phase 3B+) ─────────────────────────────────────────────────────
# DATABASE_URL=mysql://user:password@host:3306/nazeefa_db

# ─── Authentication (Phase 3B+) ───────────────────────────────────────────────
# AUTH_SECRET=your-jwt-secret-minimum-32-chars
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Payment Gateways (Phase 4+) — Store in ERP vault, NOT here ──────────────
# All payment gateway credentials are managed securely through the ERP
# settings panel and stored encrypted in sys_provider_configs table

# ─── SMS / WhatsApp (Phase 4+) ────────────────────────────────────────────────
# Provider credentials managed through ERP Communications Settings

# ─── Storage / CDN (Phase 3B+) ───────────────────────────────────────────────
# STORAGE_PROVIDER=local # or 'bunny' | 's3' | 'cloudflare_r2'
# STORAGE_URL=

# ─── Search (Phase 3B+) ───────────────────────────────────────────────────────
# ISearchService implementation: 'mysql' (default) | 'meilisearch'
# SEARCH_DRIVER=mysql
